{
  "name": "@tjakit/hookshot",
  "version": "0.1.5",
  "description": "Declarative Claude Code hooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjagithub/hookshot.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "hookshot": "dist/bin/hookshot.js"
  },
  "files": [
    "dist",
    "native/build/hsparse-*.node",
    "native/build/hsparse.wasm",
    "native/build/wasm_exec.js"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "scripts/release.sh",
    "bench": "node bench/parse.bench.ts"
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@questi0nm4rk/shell-ast": "^0.8.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "mitata": "^1.0.34",
    "node-api-headers": "^1.9.0",
    "sh-syntax": "0.8.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
